# ============================================================
# .gitignore
# ============================================================

# --- Proxy list (JANGAN di-commit) ---
proxies.txt
proxies-*.txt
proxies_*.txt
!proxies.example.txt

# --- Build artifacts ---
*.exe
*.bin
*.dll
*.so
*.dylib
crash
crash-cli
crash.exe
crash-cli.exe

# --- Build directories ---
/build/
/dist/
/out/

# --- Go ---
*.test
*.out
vendor/

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo
*~
*.code-workspace

# --- OS ---
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Logs ---
*.log
logs/
crash.log

# --- Runtime data ---
*.sqlite
*.db
stats.json
cache/

# --- Secrets / config lokal ---
config.local.yaml
.env
.env.*
!.env.example

# --- Certificates / keys ---
*.key
*.pem
*.crt
!example.crt
certs/
